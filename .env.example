# Copy this file to .env for local configuration.
# Keep real credentials and personal data out of version control.

# DATABASE_URL=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=

# Optional Composio integration. Leave disabled until the SDK is installed and
# an account has been connected through Composio's normal authorization flow.
COMPOSIO_ENABLED=false
COMPOSIO_API_KEY=your_composio_api_key
COMPOSIO_USER_ID=your_local_user_id
COMPOSIO_TOOLKITS=GMAIL
COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID=your_gmail_connected_account_id
COMPOSIO_BROWSER_CONNECTED_ACCOUNT_ID=your_browser_connected_account_id
